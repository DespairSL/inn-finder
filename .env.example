# --- Web Search: Exa (обязателен, ключ на exa.ai) ---
EXA_API_KEY=
# auto | keyword | neural
EXA_SEARCH_TYPE=auto

# --- LLM: локальная модель через любой OpenAI-совместимый сервер ---
# Подходят llama.cpp, vLLM, SGLang, LM Studio, Ollama. Проверено на llama.cpp с gemma-4-12b GGUF Q4.
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=gemma-4-12b
LOCAL_LLM_API_KEY=EMPTY
# json_object | json_schema | none   (none = формат держим промптом; безопасный дефолт для gemma)
LOCAL_LLM_JSON_MODE=none
# gemma-шаблоны часто не принимают role=system -> склеиваем system в первое user-сообщение
LOCAL_LLM_SYSTEM_ROLE=false

# Проверка TLS при обходе сайтов. По умолчанию выключена: часть российских сайтов
# использует сертификаты НУЦ РФ, недоступные системному хранилищу.
INN_FINDER_VERIFY_TLS=0
